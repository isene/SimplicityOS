#!/bin/sh
# Launch Simplicity OS in QEMU. Builds first if needed.
# Usage: run-simplicity       (BIOS boot)
#        run-simplicity -u    (UEFI boot via OVMF)
#
# X autorepeat is slowed to 20/s while QEMU runs: faster repeat
# outruns QEMU's curses input path (~55 chars/s), queueing stale
# keys that replay long after release. At 20/s nothing queues, so
# holding a key in a game moves smoothly and stops on release.
# The previous rate is restored when QEMU exits.
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
if [ -n "$DISPLAY" ] && command -v xset >/dev/null 2>&1; then
    saved=$(timeout 1 xset q 2>/dev/null | awk '/auto repeat delay/ {print $4, $7}')
    if [ -n "$saved" ]; then
        timeout 1 xset r rate 500 20
        trap 'timeout 1 xset r rate $saved' EXIT INT TERM
    fi
fi
if [ "$1" = "-u" ]; then
    make run-uefi
else
    make run
fi
